<style>
.ymal-wrap {
  padding: 20px 0 10px;
  border-top: 1px solid var(--color-border, #e8e8e8);
}
.ymal-title {
  font-size: 1rem;
  font-weight: 500;
  margin: 0 0 14px;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  border-bottom: 1px solid #e9e9e8;
}
.ymal-track {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 8px;
  scrollbar-width: none;
}
.ymal-track::-webkit-scrollbar { display: none; }

.ymal-card {
  flex: 0 0 calc(33.333% - 8px);
  scroll-snap-align: start;
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
}

/* ── Image wrapper ── */
.ymal-card__img-wrap {
  position: relative;
  border-radius: 6px;
  overflow: hidden;
  background: #f5f5f5;
  aspect-ratio: 1 / 1;
}

/* ── Slider ── */
.ymal-card__img-slider {
  width: 100%;
  height: 100%;
  position: relative;
}
.ymal-slide {
  display: none;
  width: 100%;
  height: 100%;
}
.ymal-slide.active {
  display: block;
}
.ymal-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ── Arrows ── */
.ymal-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: transparent;
  border: none;
  border-radius: 50%;
  width: 24px;
  height: 24px;
  font-size: 18px;
  line-height: 1;
  cursor: pointer;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  color: #fff;
  box-shadow: 0 1px 4px rgba(0,0,0,0.15);
  transition: opacity 0.2s;
}
.ymal-card__img-wrap:hover .ymal-arrow { opacity: 1; }
.ymal-arrow--prev { left: 22px; }
.ymal-arrow--next { right: 22px; }

/* ── Badge ── */
.ymal-badge {
  position: absolute;
  top: 8px;
  left: 8px;
  background: #fff;
  color: #111;
  font-size: 10px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 3px;
  z-index: 3;
  letter-spacing: 0.03em;
}

/* ── Cart icon button ── */
.ymal-cart-btn {
  position: absolute;
  bottom: 8px;
  right: 8px;
  background: transparent;
  border-radius: 10px;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  color: #333;
  transition: opacity 0.2s;
  text-decoration: none;
  border: 1px solid gray;
}
.ymal-card__img-wrap:hover .ymal-cart-btn { opacity: 1; }

/* ── Info ── */
.ymal-card__info {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.ymal-card__name {
  font-size: 12px;
  font-weight: 500;
  color: inherit;
  text-decoration: none;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ymal-card__vendor {
  font-size: 11px;
  color: #888;
  margin: 0;
}
.ymal-card__price {
  display: flex;
  flex-direction: column;
  gap: 1px;
  margin-top: 2px;
}
.ymal-price--regular { font-size: 12px; font-weight: 500; color: #111; }
.ymal-price--sale    { font-size: 12px; font-weight: 600; color: #2e7d32; }
.ymal-price--compare { font-size: 11px; color: #aaa; }
@media (max-width: 768px) {
  .ymal-arrow--prev{
    left: 12px;
  }
  .ymal-arrow--next {
    right: 12px;
}
}
</style>

<script>
(function() {
  function initYmalSliders() {
    document.querySelectorAll('.ymal-card__img-slider').forEach(function(slider) {
      if (slider.dataset.ymalInit) return;
      slider.dataset.ymalInit = 'true';

      var slides = slider.querySelectorAll('.ymal-slide');
      var current = 0;

      function goTo(n) {
        slides[current].classList.remove('active');
        current = (n + slides.length) % slides.length;
        slides[current].classList.add('active');
      }

      var prev = slider.querySelector('.ymal-arrow--prev');
      var next = slider.querySelector('.ymal-arrow--next');

      if (prev) prev.addEventListener('click', function(e) {
        e.preventDefault(); e.stopPropagation(); goTo(current - 1);
      });
      if (next) next.addEventListener('click', function(e) {
        e.preventDefault(); e.stopPropagation(); goTo(current + 1);
      });
    });
  }

  // Run on load
  document.addEventListener('DOMContentLoaded', initYmalSliders);

  // Re-run when cart drawer opens (Shopify cart drawer fires this event)
  document.addEventListener('cart-drawer:open', initYmalSliders);

  // Fallback: observe DOM for when drawer becomes visible
  var observer = new MutationObserver(function() { initYmalSliders(); });
  observer.observe(document.body, { childList: true, subtree: true });
})();
</script>
{% endif %}

