  {% assign shop_metafields = shop.metafields.settings.general %}


<div id="fullscreen-modal" class="modal-overlay" style="display: none;">
  <div class="modal-content">
    {% comment %}
      The customizer markup (and its images / heavy DOM) lives inside this <template> so
      nothing renders or loads at page load. customizer-open.js clones it into the DOM and
      loads the customizer scripts the first time #open-modal is clicked (lazy load).
    {% endcomment %}
    <template
      id="customizer-template"
      data-option-card-src="{{ 'option-card.js' | asset_url }}"
    >
      <div class="customizer-desktop-only">
        {% render 'customizer-tab', current_product: shop_metafields %}
      </div>
      {% render 'customizer-new' %}
    </template>
  </div>
</div>
<style>
   .modal-overlay {
  position: fixed;
    /* top: 7rem; */
    left: 50%;
    width: 100%;
    /* height: calc(100% - 7rem); */
    /* height: 100%; */
    /* background: white; */
     background: #EEEEEE;
    {% comment %} z-index: 11; {% endcomment %}
    display: flex;
    justify-content: center;
    /* align-items: center; */
    /* max-width: 1720px; */
    transform: translateX(-50%);
   }
   .modal-content {
      /* background: #FAFAFA; */
      background: #EEEEEE;
     max-height: 100%;
     /* overflow-y: auto; */
     /* overflow-x: hidden; */
     padding: 40px;
     /* border-radius: 12px; */
     /* max-width: calc(100% - 1rem); */
         padding: 0px;
     width: 100%;
     display:flex;
     /* text-align: center; */
     position: relative;
     font-family: var(--font_stack_body);
    /* max-width: 1720px; */
     border:none;
     {% comment %} padding-bottom:20px; {% endcomment %}
   }
     
   .modal-btn {
     margin-top: 20px;
     padding: 12px 24px;
     font-size: 16px;
     background-color: #000;
     color: white;
     border: none;
     cursor: pointer;
   }
   .modal-btn:hover {
     background-color: #333;
   }

   /* Loading state on the "open customizer" button */
   .open-modal.is-loading {
     pointer-events: none;
     position: relative;
   }
   .open-modal.is-loading .btn {
     opacity: 0.45;
   }
   .open-modal.is-loading::after {
     content: "";
     position: absolute;
     top: 50%;
     left: 50%;
     width: 18px;
     height: 18px;
     margin: -9px 0 0 -9px;
     border: 2px solid currentColor;
     border-top-color: transparent;
     border-radius: 50%;
     animation: customizer-spin 0.7s linear infinite;
   }

   /* Loader shown inside the modal while the customizer loads */
   .customizer-loader {
     position: absolute;
     inset: 0;
     z-index: 5;
     display: flex;
     flex-direction: column;
     align-items: center;
     justify-content: center;
     gap: 16px;
     background: #EEEEEE;
     font-family: var(--font_stack_body);
   }
   .customizer-loader.hidden {
     display: none;
   }
   #fullscreen-modal.is-loading-customizer .modal-content > :not(.customizer-loader):not(template) {
     visibility: hidden;
   }
   .customizer-loader__spinner {
     width: 46px;
     height: 46px;
     border: 4px solid rgba(0, 0, 0, 0.15);
     border-top-color: #794d49;
     border-radius: 50%;
     animation: customizer-spin 0.7s linear infinite;
   }
   .customizer-loader__text {
     font-size: 15px;
     letter-spacing: 0.04em;
     color: #794d49;
   }
   @keyframes customizer-spin {
     to { transform: rotate(360deg); }
   }
</style>
{% comment %} <script src="{{ 'option-card.js' | asset_url }}" defer="defer"></script> {% endcomment %}
