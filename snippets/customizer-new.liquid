{% if optional_customization != blank %}

  {% assign current_variant = optional_customization.value %}
  
{% endif %}

{% render 'customizer-summary', current_variant: current_variant, shop_metafields: shop_metafields %}
<style>
    .btn-next-tab.disabled{
      /* display:none; */
