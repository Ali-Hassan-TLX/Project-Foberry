    <div class="customizer_content hide_selection" style="height: 100%;">
      {% comment %}
                  <div class="customizer-desktop-only">
        {% render 'customizer-tab', current_product: shop_metafields %}
        </div>
      {% endcomment %}
      <div class="product_form_wrapper">
        {% comment %} {{ position_type }}position_type {% endcomment %}
        {% render 'option-cards',
          section_options: custom_selections,
          options: custom_selections.style_options,
          contrast_options: custom_selections.contrast_options,
          monogram: custom_selections.monogram
        %}
        {% render 'customizer-sizes', size_options: custom_selections.size_options %}
        {% render 'customizer-monogram',
          monogram: custom_selections.monogram,
          position_type: custom_selections.position_type
        %}
        
        {% comment %}
          style="display:none"
        {% endcomment %}
      </div>
      <div class="info-popup">
</div>
      <div class="footer-btns commonly">
        <a href="#" class="btn-prev-tab disabled">Prev</a>
        <div class="custom_price" default-price="{{ price | money }}">
          <span>Total : {{ price | money_without_trailing_zeros }}</span>
        </div>
        <a data-id="contrast-tab" href="#" class="btn-next-tab disabled">Next</a>
        <a data-id="apply_btn" href="#" class="apply_btn hidden disabled">Apply</a>
      </div>
      <div class="hidden footer-btns  specific_mono">
        <a href="#" class="mono-prev-tab ">Prev</a>
        <div class="custom_price" default-price="{{ price | money }}">
          <span>Total:{{ price | money }}</span>
        </div>
        <a href="#" class="mono-next-tab  ">Next</a>
        <a data-id="apply_btn" href="#" class="apply_mono_btn hidden">Apply</a>
      </div>
    </div>

