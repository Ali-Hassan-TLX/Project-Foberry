{{ 'customizer-new.css' | asset_url | stylesheet_tag }}
{% comment %} Customizer {% endcomment %}

<div
  class="product_template customizer hide_selection"
  id="ProductSection-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="product"
  data-enable-history-state="true"
  style="display:none;"
>
  {%- assign current_variant = product -%}
  {%- assign product_image_zoom_size = '1024x1024' -%}
  {%- assign enable_zoom = section.settings.enable_zoom -%}
  {%- assign product_image_scale = '2' -%}
  {%- assign enable_fancybox = section.settings.enable_fancybox -%}
  {%- assign compare_at_price = current_variant.compare_at_price -%}
  {% comment %} {%- assign price = current_variant.price -%} {% endcomment %}
  {% assign shop_metafields = shop.metafields.settings.general %}

  {% assign current_collection = nil %}

{% for collection in product.collections %}
  {% if collection.metafields.option_group.customization  != blank %}
    {% assign current_collection = collection %}
    {% break %}
  {% endif %}
{% endfor %}

{% assign metaproduct = product.metafields.option_group.customization %}
{% assign optional_customization = product.metafields.custom.customization_option_product %}
{%  liquid
  assign product_title = 
  assign product_image = 
  assign price = 
  assign product_description = 

  if optional_customization != blank 
  assign product_title = optional_customization.value.title
  assign product_image = optional_customization.value.featured_image
  assign price = optional_customization.value.price
  assign product_description = optional_customization.value.description
  else
  assign product_title = product.title
  assign product_image = product.featured_image
  assign price = product.price
  assign product_description = product.description
    
  endif


%}

{% if metaproduct != blank %}
  {% assign custom_selections = metaproduct %}
{% elsif current_collection and current_collection.metafields.option_group.customization != blank %}
  {% assign custom_selections = current_collection.metafields.option_group.customization %}
{% elsif optional_customization != blank and optional_customization.value != blank %}

  {% assign optional_product = optional_customization.value %}

  {%- comment -%} 1. Try metafield on product {%- endcomment -%}
  {% assign optional_meta = optional_product.metafields.option_group.customization %}

  {% if optional_meta != blank %}
    {% assign custom_selections = optional_meta %}

  {% else %}

    {%- comment -%} 2. Fallback to collections of referenced product {%- endcomment -%}
    {% assign found_meta = blank %}

    {% for col in optional_product.collections %}
      {% if col.metafields.option_group.customization != blank %}
        {% assign found_meta = col.metafields.option_group.customization %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if found_meta != blank %}
      {% assign custom_selections = found_meta %}
    {% endif %}

  {% endif %}

{% endif %}


  <div class="main-customizer-new product_top product_layout {%if collection.previous_product or collection.next_product %}next-prev-product-wrapper{% endif %} ">
    <button id="close-modal" class="modal-close hide_selection">
      <svg xmlns="http://www.w3.org/2000/svg" width="45.422" height="42.421" viewBox="3414.623 571.977 45.422 42.421">
        <g data-name="Group 102"><g data-name="Path 71"><path d="m3455.956 571.977-37.244 42.336" fill="#794d49" fill-rule="evenodd"/><path d="m3455.956 571.977-37.244 42.336" stroke-linejoin="round" stroke-linecap="round" stroke-width="4" stroke="#d3736b" fill="transparent"/></g><g data-name="Path 72"><path d="m3456.799 614.399-38.93-40.794" fill="#d3736b" fill-rule="evenodd"/><path d="m3456.799 614.399-38.93-40.794" stroke-linejoin="round" stroke-linecap="round" stroke-width="4" stroke="#d3736b" fill="transparent"/></g></g>
      </svg>
    </button>
    {% comment %}
          <div class="customizer-desktop-only">
        {% render 'customizer-tab', current_product: shop_metafields %}

      </div>
                   <div class="customizer-mobile-only hidden">
        {% render 'customizer-tab', current_product: shop_metafields %}
        </div>
    {% endcomment %}

    <div class=" hide_selection image_and_btn fabric_box">
      <div class="product-image">
        <div class="image">
          <img
            src="{{ product_image | img_url: '2000x'}}"
            width="655"
            height="485"
          >
          <div class="main_img_info">
            {% comment %}
              {{ 'info-icon.svg' | inline_asset_content }}
            {% endcomment %}
            <button
              type="button"
              class="info_btn"
              data-toggle="modal"
              data-target="#{{ product_title }}"
            >
              <img src="  {{ 'info-icon.svg' | asset_url }}" width="100%" height="100%">
            </button>
          </div>

          <span> {{ product_title }}</span>
          <!-- <span> Shirts Multi Buy | Buy 5 and get 15% off </span> -->
        </div>
        <div
          class="modal fade"
          id="{{ product_title }}"
          tabindex="-1"
          role="dialog"
          aria-hidden="true"
        >
          <div class="modal-dialog" role="document">
            <div class="modal-content">
              <button
                type="button"
                data-target="{{ product_title }}"
                class="close_btn"
                data-dismiss="modal"
                aria-label="Close"
              >
                <span aria-hidden="true">X</span>
              </button>
              <div class="modal-body">
                <p class="modal-title">{{ product_title }}</p>
                <div class="additional_popup_details">
                  {{ product.description }}
                </div>
              </div>
              <div class="modal-img">
                <img
                  src="{{ product_image | img_url: '2000x'}}"
                  width="250"
                  height="250"
                >
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="button-container mobile_only ">
        <button class="start-button action-button" id="start-again-button">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="104.169"
            height="127.084"
            viewBox="4498.224 543.988 104.169 127.084"
