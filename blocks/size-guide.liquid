      <div class="size-guide-popup-content">
        <div class="close-pop-up">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M10.0303 8.96965C9.73741 8.67676 9.26253 8.67676 8.96964 8.96965C8.67675 9.26255 8.67675 9.73742 8.96964 10.0303L10.9393 12L8.96966 13.9697C8.67677 14.2625 8.67677 14.7374 8.96966 15.0303C9.26255 15.3232 9.73743 15.3232 10.0303 15.0303L12 13.0607L13.9696 15.0303C14.2625 15.3232 14.7374 15.3232 15.0303 15.0303C15.3232 14.7374 15.3232 14.2625 15.0303 13.9696L13.0606 12L15.0303 10.0303C15.3232 9.73744 15.3232 9.26257 15.0303 8.96968C14.7374 8.67678 14.2625 8.67678 13.9696 8.96968L12 10.9393L10.0303 8.96965Z" fill="#000000"></path> <path fill-rule="evenodd" clip-rule="evenodd" d="M12 1.25C6.06294 1.25 1.25 6.06294 1.25 12C1.25 17.9371 6.06294 22.75 12 22.75C17.9371 22.75 22.75 17.9371 22.75 12C22.75 6.06294 17.9371 1.25 12 1.25ZM2.75 12C2.75 6.89137 6.89137 2.75 12 2.75C17.1086 2.75 21.25 6.89137 21.25 12C21.25 17.1086 17.1086 21.25 12 21.25C6.89137 21.25 2.75 17.1086 2.75 12Z" fill="#000000"></path> </g>
          </svg>
        </div>
        {% if page_details %}
          <h2 class="size-guide-page-heading">{{ pages[page_handle].title  }}</h2>
          <div class="size-guide-page-content">
            {{ pages[page_handle].content  }}
          </div>
        {% else %}
          <h2 class="popup-heading">
            {{ size_guide_details.heading }}
          </h2>
          <div class="size-description">
            {{ size_guide_details.description | metafield_tag }}
          </div>
          <div class="size-guide-images">
            {% for image in size_guide_details.images.value %}
              <div class="size-guide-image">
                <img
                  src="{{ image | image_url: width: 800 }}"
                  alt="Size Guide Image"
                  width="800"
                  height="auto"
                >
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

<style>
        .block-{{ block.id }}{
        .size-guide-wraper {
        display: flex;
        width: 100%;
        gap: 60px;
        align-items: center;
        justify-content: space-between;
        padding: 0px;
        {% comment %} padding: 20px 20px; {% endcomment %}

      }
      .size-guide-product-title-wraper {
      display: block;
  }
  .size-guide-title{
      background: {{ background_color }};
      display: flex;
      padding: 2px 5px;
    }
  .size-guide-product-text{
      background: {{ background_color }};
      display: flex;
      padding: 2px 10px;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      border-radius: 5px;
      transition: .3s;
      .text{
        margin:0px
      }
    }
    .size-guide-product-text:hover{
      background: {{ hover_background_color }};
  }
    .size-guide-popup-wraper{
      display: flex;
      justify-content: end;
      align-items: center;
      padding: 0px;
      position: fixed;
      background: #0000006b;
      left: 100%;
      right: -100%;
      top: 0;
      bottom: 0;
      z-index: 12;
      transition: 0.5s;
  }
  .size-guide-popup-wraper.size_guide_active{
      left: 0;
      right: 0;
  }
  .size-guide-popup-content {
   display: block;
   width: 100%;
   height: 100%;
   max-width: 40%;
   background: #ffffff;
   padding: 20px;
   overflow: auto;
  }
  .close-pop-up {
      display: flex;
      justify-content: end;

      svg{
      cursor:pointer;
      width: 30px;
      }
  }
  .size-description {
      display: block;
      padding: 10px 0px;
  }
  .size-guide-image{
      border: 1px solid #000000;
      margin-bottom: 5px;
      display: block;
      width: 100%;
      img{
        object-fit: contain;
      }
  }

  @media(max-width:768px){
      .size-guide-popup-content {
          max-width: 100%;
      }
  }

        }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const openBtn = document.querySelector('.size-guide-product-text');
    const popup = document.querySelector('.size-guide-popup-wraper');
    const closeBtn = document.querySelector('.close-pop-up');
    const header = document.getElementById('header-group');

    if (!popup) return;

    // OPEN POPUP
    if (openBtn) {
      openBtn.addEventListener('click', function () {
        popup.classList.add('size_guide_active');
        document.body.style.overflow = 'hidden';
        if (header) header.classList.add('hidden');
      });
    }

    // CLOSE BUTTON
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        popup.classList.remove('size_guide_active');
        document.body.style.overflow = 'auto';
        if (header) header.classList.remove('hidden');
      });
    }

    // CLICK OUTSIDE POPUP
    popup.addEventListener('click', function (e) {
      if (e.target === popup) {
        popup.classList.remove('size_guide_active');
        document.body.style.overflow = 'auto';
        if (header) header.classList.remove('hidden');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Size Guide",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "size_guide_title",
      "label": "Size Guide Title",
      "default": "FIND MY SIZE"
    },
    {
      "type": "text",
      "id": "size_guide_text",
      "label": "Size Guide Text",
      "default": "Size Guide"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "hover_bg_color",
      "label": "Hover Background Color"
    }
  ],
  "presets": [
    {
      "name": "Size Guide"
    }
  ]
}
{% endschema %}
