{% liquid
  assign hover_background_color = block.settings.hover_bg_color
  assign background_color = block.settings.bg_color
  assign product_size_guide = block.settings.size_guide_text
  assign size_guide_title = block.settings.size_guide_title
  assign size_guide = product.metafields.custom.size_guide.value

  # show_size_guide_condition
  assign assign_collection = null
  for collection in product.collections
    if collection.metafields.option.add_ons != blank
      assign assign_collection = collection
      break
    endif
  endfor
  assign single_product = product.metafields.option.add_ons
  if single_product != blank
    assign product_data = single_product
  elsif assign_collection
    assign product_data = assign_collection.metafields.option.add_ons
  endif
  for collection in product.collections
    if collection.metafields.option_group.customization != blank
      assign current_collection = collection
      break
    endif
  endfor
  assign metaproduct = product.metafields.option_group.customization
  if metaproduct != blank
    assign customization = metaproduct
  elsif current_collection and current_collection.metafields.option_group.customization != blank
    assign customization = current_collection.metafields.option_group.customization
  endif
  assign show_size_guide =
  if customization == blank
    assign show_size_guide = false
  endif
  if product_data != blank
    assign show_size_guide = true
  endif
  # show_size_guide_condition

  for collection in product.collections
    if collection.metafields.custom.size_guide != blank
      assign size_guide_collection = collection
      break
    endif
  endfor
  if size_guide_collection and size_guide_collection.metafields.custom.size_guide != blank
    assign size_guide_details = size_guide_collection.metafields.custom.size_guide.value
  endif
  assign page_details = size_guide_details.page_or_fields
  assign page_handle = size_guide_details.size_page 


%}

