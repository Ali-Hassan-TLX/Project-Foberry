{% doc %}
  Renders a custom promotional banner inside the product grid at a specific product index.

  The banner is rendered only when `current_index` passed from the section
  matches the `display_at_index` setting configured on the block.

  @param {number} current_index - The current 1-based product index in the loop.

  @example
  {% content_for 'block', type: 'custom_banner', id: 'custom-banner', current_index: forloop.index %}
{% enddoc %}

{% liquid
  assign current_index = current_index | default: 0

  if block.settings.display_at_index != current_index
    assign should_render = false
  else
    assign should_render = true
  endif
%}
{% if should_render %}
  <div class="custom-insert-div {{ block.id }}">
    <div class="banner-wrapper">
      <div class="banner-content">
        {% if block.settings.brand_text != blank %}
          <div class="brand-custom">
            {{ block.settings.brand_text }}
          </div>
        {% endif %}

        {% if block.settings.brand_subtext != blank %}
          <div class="brand-divider">
            <div class="brand-line"></div>
            <span class="brand-shirts">
              {{ block.settings.brand_subtext }}
            </span>
          </div>
        {% endif %}

        {% if block.settings.headline != blank or block.settings.headline_bold != blank %}
          <div class="banner-headline">
            {{ block.settings.headline }}
            {% if block.settings.headline_bold != blank %}
              <strong>{{ block.settings.headline_bold }}</strong>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.btn_primary_text != blank or block.settings.btn_secondary_text != blank %}
          <div class="banner-buttons">
            {% if block.settings.btn_primary_text != blank %}
              <a href="{{ block.settings.btn_primary_link }}" class="btn-primary">
                {{ block.settings.btn_primary_text }}
              </a>
            {% endif %}

            {% if block.settings.btn_secondary_text != blank %}
              <a href="{{ block.settings.btn_secondary_link }}" class="btn-secondary">
                {{ block.settings.btn_secondary_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}
{% style %}
   .{{ block.id }} .banner-wrapper {
    position: relative;
    width: 100%;
    min-height: 420px;
    background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: flex-end;  /* content on the right like original */
  }
   .{{ block.id }} .banner-content {
    position: relative;
    z-index: 2;
    padding: 50px 50px 50px 20px;
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 50%;
  }
{% endstyle %}
{% comment %}
{% stylesheet %}
  .custom-insert-div {
    width: 100%;
  }

  .banner-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .banner-content {
    width: 100%;
    max-width: 1200px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .brand-custom {
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .brand-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-line {
    flex: 1;
    height: 1px;
  }

  .brand-shirts {
    font-size: 0.875rem;
  }

  .banner-headline {
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .banner-headline strong {
    font-weight: 700;
  }

  .banner-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .banner-buttons .btn-primary,
  .banner-buttons .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.4rem;
    font-size: 0.9rem;
    text-decoration: none;
    border-radius: 999px;
  }

  .banner-buttons .btn-primary {
  }

  .banner-buttons .btn-secondary {
  }
{% endstylesheet %}
{% endcomment %}
{% schema %}
{
  "name": "Custom banner",
  "settings": [
  {
  "type": "image_picker",
  "id": "background_image",
  "label": "upload image",
  },
    {
      "type": "range",
      "id": "display_at_index",
      "label": "Display at product index",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 14
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text"
    },
    {
      "type": "text",
      "id": "brand_subtext",
      "label": "Brand subtext"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline"
    },
    {
      "type": "text",
      "id": "headline_bold",
      "label": "Headline (bold part)"
    },
    {
      "type": "text",
      "id": "btn_primary_text",
      "label": "Primary button text"
    },
    {
      "type": "url",
      "id": "btn_primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "btn_secondary_text",
      "label": "Secondary button text"
    },
    {
      "type": "url",
      "id": "btn_secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Custom banner"
    }
  ]
}
{% endschema %}