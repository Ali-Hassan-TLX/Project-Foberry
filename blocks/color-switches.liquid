{% liquid
  assign background_color = block.settings.bg_color
  assign product_size_guide = block.settings.size_guide_text
  assign size_guide_title = block.settings.size_guide_title

  # Metafield is expected to be a list of product references
  assign color_switches = product.metafields.custom.color_switchs.value
%}

<style>
  .block-{{ block.id }} .color-switches {
    display: flex;
    gap: 10px;
    margin: 15px 0;
    flex-wrap: wrap;
    padding-right: 10px;
  }
  .color-switch {
    width: 50px;
    height: 50px;
    border: 1px solid #e2e2e2;
    border-radius: 4px; /* Matches your preferred clean UI */
    overflow: hidden;
    transition: 0.3s;
  }
  .color-switch:hover {
    border-color: #000;
    padding: 3px;
  }
  .color-switch.active {
    border: 2px solid #000;
    padding: 3px;
  }
  .color-switch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .active-color-heading{
  font-size:14px;
  font-weight:500;
  }
</style>

{% if color_switches != blank %}
  <div class="block-{{ block.id }}">
    <div class="color-switch-wraper">
      <div class="active-color">
        <span class="active-color-heading">Color:</span> <span class="current-active-name"></span>
      </div>
      <div class="color-switches">
        {% for color_switch in color_switches %}
          {%- comment -%}
            Check if the iterated product is the one the user is currently viewing
          {%- endcomment -%}
          <div
            class="color-switch{% if color_switch.handle == product.handle %} active{% endif %}"
            data-title="{{ color_switch.title }}"
          >
            <a href="{{ color_switch.url }}" title="{{ color_switch.title }}">
              {% if color_switch.images.size > 0 %}
                {%- comment -%}
                  Grab the very last image from the product's image list
                {%- endcomment -%}
                {% assign last_image = color_switch.images | last %}
                <img
                  src="{{ last_image | image_url: width: 100 }}"
                  alt="{{ color_switch.title }}"
                  loading="lazy"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const switches = document.querySelectorAll('.color-switch');
    const currentName = document.querySelector('.current-active-name');

    if (!switches.length || !currentName) return;

    let activeSwitch = document.querySelector('.color-switch.active');

    // SET DEFAULT ACTIVE NAME ON LOAD
    if (activeSwitch) {
      currentName.textContent = activeSwitch.dataset.title;
    }

    // LOOP THROUGH SWITCHES
    switches.forEach(function (item) {
      // HOVER → SHOW HOVER NAME
      item.addEventListener('mouseenter', function () {
        currentName.textContent = item.dataset.title;
      });

      // LEAVE → BACK TO ACTIVE
      item.addEventListener('mouseleave', function () {
        if (activeSwitch) {
          currentName.textContent = activeSwitch.dataset.title;
        }
      });

      // CLICK → UPDATE ACTIVE (optional but recommended)
      item.addEventListener('click', function () {
        switches.forEach((el) => el.classList.remove('active'));
        item.classList.add('active');

        activeSwitch = item;
        currentName.textContent = item.dataset.title;
      });
    });
  });
</script>

{% schema %}
{
  "name": "Color switches",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Color switches"
    }
  ]
}
{% endschema %}
