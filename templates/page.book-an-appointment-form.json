        "text_aqtcU3": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p><strong><br/>What’s the process?</strong></p><ul><li>Our sales rep will call and confirm a convenient time for the visit.</li><li>He will visit you at your office or home along with a range of fabrics displayed in Foberry’s Catalogues and the Measurement Kit to ensure your perfect measurements.</li><li>You can touch and feel the fabrics in real time and he will assist you regarding the selection of fabrics and designs as your personal stylist.</li><li>He can take your body measurement or shirt measurements, or you can also give him a perfect fit shirt of yours so that we can take a pattern out of it.</li><li>The sales rep will ensure personally that your custom shirts are stitched top-notch and all your requirements are fulfilled.</li><li>Once the shirt is crafted, he will visit you and let you wear and feel comfortable in your custom shirt so that you are fully satisfied.</li></ul><p> </p>",
            "width": "100%",
            "max_width": "none",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
