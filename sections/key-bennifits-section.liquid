{{ 'https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.css' | stylesheet_tag }}

{% style %}
  .key-benefits-section {
    width: 100%;
    border-radius: {{ section.settings.section_border_radius }}px;
    overflow: hidden;
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .page-width {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .benefits-title {
    text-align: center;
    margin: 0 0 6px 0;
    font-size: 23.14px;
    font-weight: 400;
    line-height: 27.768px;
    color: rgb(52, 49, 49);
  }

  .benefits-subtitle {
    text-align: center;
    font-size: 14.5px;
    font-weight: 400;
    line-height: 21.75px;
    color: rgb(125, 125, 125);
  }

  /* ── Grid mode (≤ 6 blocks on desktop) ── */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
  }

  /* ── Swiper mode ── */
  .benefits-swiper-wrap {
    display: none;
    position: relative;
  }

  .benefits-swiper-wrap .swiper {
    width: 100%;
  }

  .benefits-swiper-wrap .swiper-slide {
    height: auto;
  }

  /* Navigation buttons — glass circle */
  .benefits-swiper-wrap .swiper-button-prev,
  .benefits-swiper-wrap .swiper-button-next {
    color: {{ section.settings.swiper_nav_color }};
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.10), inset 0 1px 0 rgba(255,255,255,0.5);
    transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    top: 50%;
    transform: translateY(-50%);
  }

  .benefits-swiper-wrap .swiper-button-prev:hover,
  .benefits-swiper-wrap .swiper-button-next:hover {
    background: rgba(255, 255, 255, 0.40);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.14), inset 0 1px 0 rgba(255,255,255,0.6);
    transform: translateY(-50%) scale(1.06);
  }

  .benefits-swiper-wrap .swiper-button-prev::after,
  .benefits-swiper-wrap .swiper-button-next::after {
    font-size: 14px;
    font-weight: 700;
  }

  /* Pagination dots */
  .benefits-swiper-wrap .swiper-pagination-bullet {
    background: {{ section.settings.swiper_nav_color }};
    opacity: 0.4;
  }

  .benefits-swiper-wrap .swiper-pagination-bullet-active {
    opacity: 1;
  }

  .benefits-swiper-wrap .swiper-pagination {
    position: relative;
    margin-top: 16px;
    display:none;
  }

  /* ── Shared item styles ── */
  .benefit-item {
    text-align: center;
    padding: 20px;
    transition: transform 0.3s ease;
  }

  .benefit-item:hover {
    transform: translateY(-5px);
  }

  .benefit-icon {
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .benefit-icon img{
    width: 150px;
  }

  .benefit-icon svg {
    display: block;
  }

  .benefit-title {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 20px;
  }

  .benefit-description {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    opacity: 0.85;
  }

  /* ── Tablet ── */
  @media screen and (max-width: 989px) {
    .benefits-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .benefits-title {
      font-size: 32px;
    }
  }

  /* ── Mobile — always Swiper ── */
  @media screen and (max-width: 749px) {
    .benefits-grid {
      display: none !important;
    }

    .benefits-swiper-wrap {
      display: block !important;
    }

    .benefits-title {
      font-size: {{ section.settings.title_font_size_mobile }}px !important;
    }

    .benefits-subtitle {
      font-size: {{ section.settings.subtitle_font_size_mobile }}px !important;
    }

    .benefit-title {
      font-size: {{ section.settings.block_title_font_size_mobile }}px !important;
    }

    .benefit-description {
      font-size: {{ section.settings.block_desc_font_size_mobile }}px !important;
    }
    .key-benefits-section{
      margin-bottom: 30px;
    }
  }
{% endstyle %}

<div  class="key-benefits-section">
  <div class="section section-page-width">

    {% if section.settings.title != blank %}
      <h2
        class="benefits-title"
        style="color: {{ section.settings.title_color }}; font-size: {{ section.settings.title_font_size_desktop }}px;"
      >
        {{ section.settings.title }}
      </h2>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <p
        class="benefits-subtitle"
        style="color: {{ section.settings.subtitle_color }}; font-size: {{ section.settings.subtitle_font_size_desktop }}px;"
      >
        {{ section.settings.subtitle }}
      </p>
    {% endif %}

    {% assign block_count = section.blocks | size %}

    {%- capture benefit_items -%}
      {% for block in section.blocks %}
        <div class="benefit-item" {{ block.shopify_attributes }}>
          <div class="benefit-icon" style="color: {{ block.settings.icon_color }};">
            {% if block.settings.custom_icon != blank %}
              <img
                src="{{ block.settings.custom_icon | image_url: width: 64 }}"
                alt="icon"
                style="display:block;margin:0 auto;"
                width="{{ section.settings.icon_image_width }}"
                height="{{ section.settings.icon_image_height }}"
              />
            {% else %}
              {% case block.settings.icon %}
                {% when 'checkmark' %}
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                {% when 'star' %}
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                {% when 'heart' %}
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                {% when 'gift' %}
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <polyline points="20 12 20 22 4 22 4 12"></polyline>
                    <rect x="2" y="7" width="20" height="5"></rect>
                    <line x1="12" y1="22" x2="12" y2="7"></line>
                    <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                    <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                  </svg>
                {% when 'truck' %}
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                {% when 'shield' %}
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                {% when 'lock' %}
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                {% when 'zap' %}
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                  </svg>
                {% when 'globe' %}
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                  </svg>
                {% when 'tag' %}
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                    <line x1="7" y1="7" x2="7.01" y2="7"></line>
                  </svg>
                {% else %}
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
              {% endcase %}
            {% endif %}
          </div>

          <div class="benefit-content">
            {% if block.settings.title != blank %}
              <h3
                class="benefit-title"
                style="color: {{ block.settings.title_color }}; font-size: {{ section.settings.block_title_font_size_desktop }}px;"
              >
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <p
                class="benefit-description"
                style="color: {{ block.settings.description_color }}; font-size: {{ section.settings.block_desc_font_size_desktop }}px;"
              >
                {{ block.settings.description }}
              </p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    {%- endcapture -%}

    {%- comment -%} Desktop grid: shown when ≤ 6 blocks (hidden via JS if > 6) {%- endcomment -%}
    <div
      class="benefits-grid"
      id="benefits-grid-{{ section.id }}"
      {% if block_count > 6 %}style="display:none;"{% endif %}
    >
      {{ benefit_items }}
    </div>

    {%- comment -%} Swiper: shown when > 6 blocks on desktop, always on mobile {%- endcomment -%}
    <div
      class="benefits-swiper-wrap"
      id="benefits-swiper-wrap-{{ section.id }}"
      {% unless block_count > 6 %}style="display:none;"{% endunless %}
    >
      <div class="swiper" id="benefits-swiper-{{ section.id }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div class="benefit-item" style="padding: 16px 10px;">
                <div class="benefit-icon" style="color: {{ block.settings.icon_color }};">
                  {% if block.settings.custom_icon != blank %}
                    <img
                      src="{{ block.settings.custom_icon | image_url: width: 64 }}"
                      alt="icon"
                      style="display:block;margin:0 auto;"
                      width="{{ section.settings.icon_image_width }}"
                      height="{{ section.settings.icon_image_height }}"
                    />
                  {% else %}
                    {% case block.settings.icon %}
                      {% when 'checkmark' %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      {% when 'star' %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                      {% when 'heart' %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                      {% when 'gift' %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
                      {% when 'truck' %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                      {% when 'shield' %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                      {% when 'lock' %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                      {% when 'zap' %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                      {% when 'globe' %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                      {% when 'tag' %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                      {% else %}
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    {% endcase %}
                  {% endif %}
                </div>

                <div class="benefit-content">
                  {% if block.settings.title != blank %}
                    <h3
                      class="benefit-title"
                      style="color: {{ block.settings.title_color }}; font-size: {{ section.settings.block_title_font_size_desktop }}px;"
                    >
                      {{ block.settings.title }}
                    </h3>
                  {% endif %}

                  {% if block.settings.description != blank %}
                    <p
                      class="benefit-description"
                      style="color: {{ block.settings.description_color }}; font-size: {{ section.settings.block_desc_font_size_desktop }}px;"
                    >
                      {{ block.settings.description }}
                    </p>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="swiper-pagination"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      </div>
    </div>

  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.js" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sectionId   = '{{ section.id }}';
    var blockCount  = {{ block_count }};
    var isMobile    = window.innerWidth <= 749;
    var grid        = document.getElementById('benefits-grid-'        + sectionId);
    var swiperWrap  = document.getElementById('benefits-swiper-wrap-' + sectionId);

    function initSwiper() {
      if (!swiperWrap) return;

      swiperWrap.style.display = 'block';
      if (grid) grid.style.display = 'none';

      new Swiper('#benefits-swiper-' + sectionId, {
        slidesPerView: isMobile ? {{ section.settings.swiper_slides_mobile }} : {{ section.settings.swiper_slides_desktop }},
        spaceBetween: isMobile ? 12 : 20,
        loop: false,
        grabCursor: true,
        {% if section.settings.swiper_autoplay %}
        autoplay: {
          delay: 3000,
          disableOnInteraction: false,
        },
        {% endif %}
        pagination: {
          el: '#benefits-swiper-' + sectionId + ' .swiper-pagination',
          clickable: true,
        },
        navigation: {
          nextEl: '#benefits-swiper-' + sectionId + ' .swiper-button-next',
          prevEl: '#benefits-swiper-' + sectionId + ' .swiper-button-prev',
        },
        breakpoints: {
          750: {
            slidesPerView: {{ section.settings.swiper_slides_desktop }},
            spaceBetween: 20,
          }
        }
      });
    }

    if (isMobile) {
      // Mobile: always use Swiper
      initSwiper();
    } else if (blockCount > 6) {
      // Desktop: Swiper only when > 6 blocks
      initSwiper();
    }
    // Desktop with ≤ 6 blocks: grid is already visible via CSS/Liquid
  });
</script>

{% schema %}
{
  "name": "Key Benefits",
  "tag": "section",
  "class": "section-key-benefits",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Why Choose Us"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Discover the benefits of shopping with us"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Section Border Radius"
    },
    {
      "type": "range",
      "id": "section_border_radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Section Corner Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Swiper Settings"
    },
    {
      "type": "range",
      "id": "swiper_slides_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Slides Visible (Desktop)",
      "default": 5
    },
    {
      "type": "range",
      "id": "swiper_slides_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Slides Visible (Mobile)",
      "default": 2
    },
    {
      "type": "color",
      "id": "swiper_nav_color",
      "label": "Swiper Nav & Dots Color",
      "default": "#343131"
    },
    {
      "type": "checkbox",
      "id": "swiper_autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "header",
      "content": "Icon Size"
    },
    {
      "type": "range",
      "id": "icon_image_width",
      "min": 20,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Custom Icon Width",
      "default": 48
    },
    {
      "type": "range",
      "id": "icon_image_height",
      "min": 20,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Custom Icon Height",
      "default": 48
    },
    {
      "type": "header",
      "content": "Font Sizes"
    },
    {
      "type": "range",
      "id": "title_font_size_desktop",
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Title Font Size (Desktop)",
      "default": 23
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Title Font Size (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "subtitle_font_size_desktop",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size (Desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "subtitle_font_size_mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size (Mobile)",
      "default": 13
    },
    {
      "type": "header",
      "content": "Block Font Sizes"
    },
    {
      "type": "range",
      "id": "block_title_font_size_desktop",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Block Heading Font Size (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "block_title_font_size_mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Block Heading Font Size (Mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "block_desc_font_size_desktop",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Block Description Font Size (Desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "block_desc_font_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Block Description Font Size (Mobile)",
      "default": 13
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "checkmark", "label": "Checkmark" },
            { "value": "star",      "label": "Star" },
            { "value": "heart",     "label": "Heart" },
