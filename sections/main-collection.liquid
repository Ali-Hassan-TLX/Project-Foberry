{% style %}
.btn-gradient{
  position: relative;
    display: inline-flex;
    align-items: stretch;
    justify-content: center;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.06em;
    cursor: pointer;
    padding: 0;
    isolation: isolate;
}
.btn-gradient::before{
  content: "";
    position: absolute;
    inset: calc(-1 * var(--grad-thickness));
    border-radius: calc(var(--btn-radius) + var(--grad-thickness));
    background: conic-gradient(from var(--grad-start), var(--grad-color-1), var(--grad-color-2), var(--grad-color-3), var(--grad-color-1));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    padding: var(--grad-thickness);
    z-index: -1;
    transition: --grad-start 0s;
}
   {%  if collection.template_suffix == 'custom-design' %}
    .product-grid  {
    grid-template-columns: repeat(18, 1fr)!important;
    column-gap: 10px!important;
  }
  .custom-insert-div{
    grid-column: span 18 !important;
  }
  .product-card{
    transition: all 0.3s ease;
    border: 1px solid transparent !important;
  }
  .product-card:hover{
    border-color: #eee !important;
  }
  .customize-card-btn.quick-add__button.new-class {
      position: unset !important;
      width: 135px !important;
      height: 35px !important;
  }
  @media (max-width: 749px){
    .product-grid__item{
      grid-column: span 18 !important;
    }
  }
  .sold-out-badge{
    font-size: 25px !important;
    transform: translate(-50%, -50%) rotate(-21deg) !important;
  }
  {% else %}
      .product-grid  {
    grid-template-columns: repeat(12, 1fr)!important;
    column-gap: 4px!important;
  }
  {% endif %}
{% endstyle %}
