            {% assign bs_bg2_key   = 'btn_secondary_bg2_'        | append: i %}
            {% assign bs_tc_key    = 'btn_secondary_text_color_' | append: i %}
            {% assign bs_hbg_key   = 'btn_secondary_hover_bg_'   | append: i %}
            {% assign bs_htc_key   = 'btn_secondary_hover_text_' | append: i %}
            {% assign bs_fs_key    = 'btn_secondary_font_size_'  | append: i %}
            {% assign bp_style_key = 'insert_' | append: i | append: '_button_style_p' %}

            {% assign bs_style = section.settings[bs_style_key] | default: 'simple' %}
            {% assign bs_bg    = section.settings[bs_bg_key2]   | default: '#ffffff' %}
            {% assign bs_bg2   = section.settings[bs_bg2_key]   | default: '#dddddd' %}

            {% if bs_style == 'gradient' %}
              {% assign bs_bg_css     = 'linear-gradient(135deg, ' | append: bs_bg | append: ', ' | append: bs_bg2 | append: ')' %}
              {% assign bs_border_css = 'none' %}
            {% elsif bs_style == 'outline' %}
              {% assign bs_bg_css     = 'transparent' %}
              {% assign bs_border_css = '1.5px solid ' | append: bs_bg %}
            {% else %}
              {% assign bs_bg_css     = bs_bg %}
              {% assign bs_border_css = 'none' %}
            {% endif %}

            
              <a href="{{ section.settings[bs_lnk_key] }}"
              class="btn-custom {% if section.settings[bp_style_key] == 'gradient' %}dib-grad-btn{% else %}btn-primary{% endif %}"
            ><span class="dib-grad-btn__label">{{ section.settings[bs_txt_key] }}</span></a>
          {% endif %}

        </div>
      {% endif %}

    </div>
  </div>
</div>

    {% endif %}
  {% endif %}
{% endfor %}                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                         
