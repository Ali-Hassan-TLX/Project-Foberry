  {% assign bt_sz_key   = 'brand_text_size_'        | append: i %}
  {% assign bt_wt_key   = 'brand_text_weight_'      | append: i %}
  {% assign bt_st_key   = 'brand_text_style_'       | append: i %}
  {% assign bt_sp_key   = 'brand_text_spacing_'     | append: i %}

  {% assign bs_col_key  = 'brand_subtext_color_'    | append: i %}
  {% assign bs_sz_key   = 'brand_subtext_size_'     | append: i %}
