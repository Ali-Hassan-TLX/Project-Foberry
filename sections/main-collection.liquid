<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<results-list
  class="section product-grid-container color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  data-template="{{ collection.handle }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div
    class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
  >
    {% content_for 'block',
      type: 'filters',
      id: 'filters',
      results: collection,
      results_size: collection.products_count
    %}

    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate collection.products by products_per_page %}
      {% capture children %}
     {% for product in collection.products %}
      {%  unless collection.template_suffix == 'custom-design' %}

    {% assign idx = forloop.index0 %}
    {% assign position_in_cycle = idx | modulo: 7 %}
      {% if position_in_cycle > 3 %}
      {% assign extra_class = 'product-grid-item-3' %}
          {% else %}
    {% assign extra_class = '' %}
    {% endif %}
    {% endunless %}

      <li
      id="{{ section.id }}-{{ product.id }}"
      class="product-grid__item product-grid__item--{{ forloop.index0 }} {{ extra_class }}"
      data-page="{{ paginate.current_page }}"
      data-product-id="{{ product.id }}"
      ref="cards[]" 
           > 
        {% # theme-check-disable %}
          {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
              {% # theme-check-enable %}
        </li>
             {% comment %} Multiple Custom Inserts {% endcomment %}
{% for i in (1..6) %}
  {% assign enable_key = 'enable_insert_' | append: i %}
  {% if section.settings[enable_key] %}
    {% assign index_key = 'image_index_' | append: i %}
    {% assign insert_at = section.settings[index_key] | plus: 0 %}
    {% if forloop.parentloop.index == insert_at %}

      {% assign bg_key      = 'background_image_' | append: i %}
      {% assign brand_key   = 'brand_text_'        | append: i %}
      {% assign sub_key     = 'brand_subtext_'     | append: i %}
      {% assign hl_key      = 'headline_'          | append: i %}
      {% assign hlb_key     = 'headline_bold_'     | append: i %}
      {% assign bp_txt_key  = 'btn_primary_text_'  | append: i %}
      {% assign bp_lnk_key  = 'btn_primary_link_'  | append: i %}
      {% assign bs_txt_key  = 'btn_secondary_text_' | append: i %}
      {% assign bs_lnk_key  = 'btn_secondary_link_' | append: i %}

      {% comment %} <div class="custom-insert-div">
        <div class="banner-wrapper banner-wrapper-{{ i }}" style="background-image: url('{{ section.settings[bg_key] | image_url: width: 2000 }}');">
          <div class="banner-content">
            <div class="brand-custom">{{ section.settings[brand_key] }}</div>
            <div class="brand-divider">
              <div class="brand-line"></div>
              {% if section.settings[sub_key] != blank %}
                <span class="brand-shirts">{{ section.settings[sub_key] }}</span>
              {% endif %}
            </div>
            {% if section.settings[hl_key] != blank %}
              <div class="banner-headline">
                {{ section.settings[hl_key] }}
                <strong>{{ section.settings[hlb_key] }}</strong>
              </div>
            {% endif %}
            {% if section.settings[bp_txt_key] != blank or section.settings[bs_txt_key] != blank %}
              <div class="banner-buttons">
                {% if section.settings[bp_txt_key] != blank %}
                  <a href="{{ section.settings[bp_lnk_key] }}" class="btn-primary">{{ section.settings[bp_txt_key] }}</a>
                {% endif %}
                {% if section.settings[bs_txt_key] != blank %}
                  <a href="{{ section.settings[bs_lnk_key] }}" class="btn-secondary">{{ section.settings[bs_txt_key] }}</a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
