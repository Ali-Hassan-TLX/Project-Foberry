              color: {{ section.settings[hlb_col_key] | default: '#ffffff' }};
              font-size: {{ section.settings[hlb_sz_key] | default: 40 }}px;
              font-weight: {{ section.settings[hlb_wt_key] | default: '700' }};
              text-transform: {{ section.settings[hlb_tr_key] | default: 'uppercase' }};
              letter-spacing: {{ hlb_spacing }}em;
            ">{{ section.settings[hlb_key] }}</strong>
          {% endif %}
        </div>
      {% endif %}
      {% if section.settings[bp_txt_key] != blank or section.settings[bs_txt_key] != blank %}
        <div class="banner-buttons">

          {% if section.settings[bp_txt_key] != blank %}
            {% assign bp_style_key = 'btn_primary_style_'      | append: i %}
            {% assign bp_bg_key2   = 'btn_primary_bg_'         | append: i %}
            {% assign bp_bg2_key   = 'btn_primary_bg2_'        | append: i %}
            {% assign bp_tc_key    = 'btn_primary_text_color_' | append: i %}
            {% assign bp_hbg_key   = 'btn_primary_hover_bg_'   | append: i %}
            {% assign bp_htc_key   = 'btn_primary_hover_text_' | append: i %}
            {% assign bp_fs_key    = 'btn_primary_font_size_'  | append: i %}
            {% assign bp_style_key = 'insert_' | append: i | append: '_button_style' %}

            {% assign bp_style = section.settings[bp_style_key] | default: 'outline' %}
            {% assign bp_bg    = section.settings[bp_bg_key2]   | default: '#c8a97a' %}
            {% assign bp_bg2   = section.settings[bp_bg2_key]   | default: '#a0784a' %}

