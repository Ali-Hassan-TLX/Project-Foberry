              {% assign bp_border_css = 'none' %}
              {% assign btn_class = 'btn-primary' %}
            {% elsif bp_style == 'outline' %}
              {% assign bp_bg_css     = 'transparent' %}
              {% assign bp_border_css = '1.5px solid ' | append: bp_bg %}
            {% else %}
