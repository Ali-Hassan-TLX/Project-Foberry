    display: flex;
    flex-direction: column;
    gap: 0;
    width: 50%;
  }
  /* =====================
   GRADIENT BORDER BUTTON
===================== */

/* custom animatable property */
@property --grad-start {
  syntax: '<angle>';
  initial-value: 0deg;
  inherits: false;
}

/* animation */
@keyframes dib-spin {
  to { --grad-start: 360deg; }
}

/* main button */
.dib-grad-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  font-weight: 600;
  letter-spacing: 0.06em;
  cursor: pointer;
  border-radius: 0px; /* change if needed */
  isolation: isolate;
}

/* border layer */
.dib-grad-btn::before {
  content: "";
  position: absolute;
  inset: -2px; /* border thickness */
  border-radius: 0px;

  background: conic-gradient(
    from var(--grad-start),
    #ff4d4d,
    #ffcc00,
    #6a5acd,
    #ff4d4d
  );

  -webkit-mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
          mask-composite: exclude;

  padding: 2px; /* border thickness */
  z-index: -1;
}

/* hover animation */
.dib-grad-btn:hover::before {
  animation: dib-spin 0.6s linear forwards;
}

/* inner label */
.dib-grad-btn__label {
  display: block;
  padding: 12px 28px;
  color: #fff; /* text color */
  border-radius: 0px;
  line-height: 1;
  white-space: nowrap;
}
