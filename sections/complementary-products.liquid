<script>
{% comment %} document.addEventListener("DOMContentLoaded", function () {

  /* ── DRAWER ── */
  var popup = document.querySelector(".complementary-products-drawer-wraper");
  if (!popup) return;

  var header = document.getElementById("header-group");

  function openDrawer() {
    popup.classList.add("complementary_products_active");
    document.body.style.overflow = "hidden";
    if (header) header.classList.add("hidden");
  }
  function closeDrawer() {
    popup.classList.remove("complementary_products_active");
    document.body.style.overflow = "auto";
    if (header) header.classList.remove("hidden");
  }

  document.querySelectorAll(".shop-by-look").forEach(function(btn) {
    btn.addEventListener("click", openDrawer);
  });
  var closeBtn = popup.querySelector(".close-pop-up");
  if (closeBtn) closeBtn.addEventListener("click", closeDrawer);
  popup.addEventListener("click", function(e) { if (e.target === popup) closeDrawer(); });

  /* ── DIRECT ADD (single variant) ── */
  document.querySelectorAll(".cp-add-btn").forEach(function(btn) {
    btn.addEventListener("click", function() {
      var variantId = this.dataset.variantId;
      if (!variantId) return;
      var button = this;
      button.disabled = true;
      button.textContent = "Adding...";
      closeDrawer();
      fetch("/cart/add.js", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      })
      .then(function(res) { return res.json(); })
      .then(function() {
        button.textContent = "Added to Cart";
        button.classList.add("added");
      })
      .catch(function() {
        button.textContent = "Add to bag";
        button.disabled = false;
      });
    });
  });

  /* ── SIZE MODAL: OPEN ── */
  document.querySelectorAll(".cp-size-open").forEach(function(btn) {
    btn.addEventListener("click", function() {
      var modal = document.getElementById("size-modal-" + this.dataset.productId);
      if (modal) modal.classList.add("active");
    });
  });

  /* ── SIZE MODAL: CLOSE ── */
  document.querySelectorAll(".cp-size-modal").forEach(function(modal) {
    modal.addEventListener("click", function(e) {
      if (e.target === modal) modal.classList.remove("active");
    });
    modal.querySelectorAll(".cp-close").forEach(function(btn) {
      btn.addEventListener("click", function() { modal.classList.remove("active"); });
    });
  });

  /* ── SIZE TILE: SELECT ── */
  document.querySelectorAll(".cp-size-tile:not(.sold-out)").forEach(function(tile) {
    tile.addEventListener("click", function() {
      var modal = this.closest(".cp-size-modal");
      modal.querySelectorAll(".cp-size-tile").forEach(function(t) { t.classList.remove("selected"); });
      this.classList.add("selected");
      var addBtn = modal.querySelector(".cp-modal-add-btn");
      addBtn.disabled = false;
      addBtn.dataset.variantId = this.dataset.variantId;
    });
  });

  /* ── SIZE MODAL: ADD TO CART ── */
  document.querySelectorAll(".cp-modal-add-btn").forEach(function(btn) {
    btn.addEventListener("click", function() {
      var variantId = this.dataset.variantId;
      if (!variantId) return;
      var button = this;
      var modal = button.closest(".cp-size-modal");
      fetch("/cart/add.js", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      })
      .then(function(res) { return res.json(); })
      .then(function() {
        button.textContent = "Added to Cart";
        closeDrawer();
        setTimeout(function() {
          modal.classList.remove("active");
          button.textContent = "Add to bag";
          button.disabled = true;
          delete button.dataset.variantId;
          modal.querySelectorAll(".cp-size-tile.selected").forEach(function(t) { t.classList.remove("selected"); });
        }, 1200);
      })
      .catch(function() { button.textContent = "Add to bag"; });
    });
  });

}); {% endcomment %}

document.addEventListener("DOMContentLoaded", function () {

  /* ── DRAWER ── */
  var popup = document.querySelector(".complementary-products-drawer-wraper");
  if (!popup) return;

  var header = document.getElementById("header-group");

  function openDrawer() {
    popup.classList.add("complementary_products_active");
    document.body.style.overflow = "hidden";
    if (header) header.classList.add("hidden");
  }

  function closeDrawer() {
    popup.classList.remove("complementary_products_active");
    document.body.style.overflow = "auto";
    if (header) header.classList.remove("hidden");
  }

  document.querySelectorAll(".shop-by-look").forEach(function(btn) {
    btn.addEventListener("click", openDrawer);
  });

  var closeBtn = popup.querySelector(".close-pop-up");
  if (closeBtn) closeBtn.addEventListener("click", closeDrawer);

  popup.addEventListener("click", function(e) {
    if (e.target === popup) closeDrawer();
  });

  /* ── DIRECT ADD (single variant) ── */
  document.querySelectorAll(".cp-add-btn").forEach(function(btn) {
    btn.addEventListener("click", async function() {

      var variantId = this.dataset.variantId;
      if (!variantId) return;

      var button = this;
      button.disabled = true;
      button.textContent = "Adding...";

      try {

        await fetch("/cart/add.js", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        });

        // GET UPDATED CART
        const cartRes = await fetch('/cart.js');
        const cartData = await cartRes.json();

        // THEME EVENT
        const CartUpdateEvent = (await import('@theme/events')).CartUpdateEvent;

        const event = new CartUpdateEvent(cartData, 'cp-add-to-cart', {
          itemCount: cartData.item_count,
          source: 'complementary-products'
        });

        document.dispatchEvent(event);

        // UPDATE HEADER COUNT
        document.dispatchEvent(new CustomEvent('theme:cart:change', {
          detail: { cartCount: cartData.item_count }
        }));

        // CLOSE CUSTOM DRAWER FIRST
        closeDrawer();

        // OPEN CART DRAWER
        setTimeout(function () {
          const cartDrawer = document.querySelector('cart-drawer-component');
          if (cartDrawer && cartDrawer.open) {
            cartDrawer.open();
          }
        }, 200);

        button.textContent = "Added to Cart";
        button.classList.add("added");

      } catch (err) {
        console.error(err);
        button.textContent = "Add to bag";
        button.disabled = false;
      }

    });
  });

  /* ── SIZE MODAL: OPEN ── */
  document.querySelectorAll(".cp-size-open").forEach(function(btn) {
    btn.addEventListener("click", function() {
      var modal = document.getElementById("size-modal-" + this.dataset.productId);
      if (modal) modal.classList.add("active");
    });
  });

  /* ── SIZE MODAL: CLOSE ── */
  document.querySelectorAll(".cp-size-modal").forEach(function(modal) {
    modal.addEventListener("click", function(e) {
      if (e.target === modal) modal.classList.remove("active");
    });

    modal.querySelectorAll(".cp-close").forEach(function(btn) {
      btn.addEventListener("click", function() {
        modal.classList.remove("active");
      });
    });
  });

  /* ── SIZE TILE: SELECT ── */
  document.querySelectorAll(".cp-size-tile:not(.sold-out)").forEach(function(tile) {
    tile.addEventListener("click", function() {

      var modal = this.closest(".cp-size-modal");

      modal.querySelectorAll(".cp-size-tile").forEach(function(t) {
        t.classList.remove("selected");
      });

      this.classList.add("selected");

      var addBtn = modal.querySelector(".cp-modal-add-btn");
      addBtn.disabled = false;
      addBtn.dataset.variantId = this.dataset.variantId;
    });
  });

  /* ── SIZE MODAL: ADD TO CART ── */
  document.querySelectorAll(".cp-modal-add-btn").forEach(function(btn) {
    btn.addEventListener("click", async function() {

      var variantId = this.dataset.variantId;
      if (!variantId) return;

      var button = this;
      var modal = button.closest(".cp-size-modal");

      try {

        await fetch("/cart/add.js", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        });

        // GET UPDATED CART
        const cartRes = await fetch('/cart.js');
        const cartData = await cartRes.json();

        // THEME EVENT
        const CartUpdateEvent = (await import('@theme/events')).CartUpdateEvent;

        const event = new CartUpdateEvent(cartData, 'cp-size-add-to-cart', {
          itemCount: cartData.item_count,
          source: 'complementary-products'
        });

        document.dispatchEvent(event);

        // UPDATE HEADER COUNT
        document.dispatchEvent(new CustomEvent('theme:cart:change', {
          detail: { cartCount: cartData.item_count }
        }));

        // CLOSE MODAL + CUSTOM DRAWER
        modal.classList.remove("active");
        closeDrawer();

        // OPEN CART DRAWER
        setTimeout(function () {
          const cartDrawer = document.querySelector('cart-drawer-component');
          if (cartDrawer && cartDrawer.open) {
            cartDrawer.open();
          }
        }, 200);

        button.textContent = "Added to Cart";

        setTimeout(function() {
          button.textContent = "Add to bag";
          button.disabled = true;
          delete button.dataset.variantId;

          modal.querySelectorAll(".cp-size-tile.selected").forEach(function(t) {
            t.classList.remove("selected");
          });

        }, 1200);

      } catch (err) {
        console.error(err);
        button.textContent = "Add to bag";
      }

    });
  });

});

</script>

