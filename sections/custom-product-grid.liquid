{% comment %}
  Custom Product Grid Section - Pini Parma Style
  Supports dynamic layouts: 3 products, 2 products with videos
  Can be used in Shopify Fabric theme
{% endcomment %}

<style>
  .custom-product-grid {
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px;
  }

  .grid-row {
    display: grid;
    gap: 20px;
    margin-bottom: 20px;
  }

  .grid-row.three-col {
    grid-template-columns: repeat(3, 1fr);
  }

  .grid-row.two-col {
    grid-template-columns: repeat(2, 1fr);
  }

  .product-card {
    position: relative;
    overflow: hidden;
    background: #fff;
    border-radius: 4px;
    transition: transform 0.3s ease;
  }

  .product-card:hover {
    transform: translateY(-5px);
  }

  .product-media {
    position: relative;
    padding-bottom: 133%; /* 4:3 aspect ratio */
    overflow: hidden;
    background: #f5f5f5;
  }

  .product-media img,
  .product-media video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .product-media img.secondary {
    opacity: 0;
  }

  .product-card:hover .product-media img.primary {
    opacity: 0;
  }

  .product-card:hover .product-media img.secondary {
    opacity: 1;
  }

  .product-card:hover .product-media img,
  .product-card:hover .product-media video {
    transform: scale(1.05);
  }

  .product-media video {
    cursor: pointer;
  }

  .product-info {
    padding: 15px;
    text-align: center;
  }

  .product-title {
    font-size: 14px;
    font-weight: 400;
    margin: 0 0 8px 0;
    color: #333;
    text-decoration: none;
    display: block;
  }

  .product-title:hover {
    text-decoration: underline;
  }

  .product-price {
    font-size: 16px;
    font-weight: 600;
    color: #000;
  }

  .product-price.on-sale {
    color: #c41e3a;
  }

  .product-price-compare {
    text-decoration: line-through;
    color: #999;
    font-size: 14px;
    font-weight: 400;
  }

  .discount-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #c41e3a;
    color: #fff;
    padding: 5px 10px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .grid-row.three-col,
    .grid-row.two-col {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid-row.three-col,
    .grid-row.two-col {
      grid-template-columns: 1fr;
    }
  }

  .video-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 50px;
    height: 50px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .product-card:hover .video-overlay {
    opacity: 1;
  }

  .video-overlay svg {
    width: 20px;
    height: 20px;
    fill: #000;
    margin-left: 3px;
  }
</style>

<div class="custom-product-grid">
  {% assign row_counter = 0 %}
  {% assign product_counter = 0 %}
  
  {% for block in section.blocks %}
    {% assign row_counter = product_counter | modulo: 8 %}
    
    {% comment %} Start new row {% endcomment %}
    {% if row_counter == 0 %}
      <div class="grid-row three-col">
    {% elsif row_counter == 3 %}
      </div><div class="grid-row two-col">
    {% elsif row_counter == 5 %}
      </div><div class="grid-row three-col">
    {% endif %}
    
    {% comment %} Product Card {% endcomment %}
    <div class="product-card">
      <a href="{{ block.settings.product.url }}">
        <div class="product-media">
          {% comment %} Discount Badge {% endcomment %}
          {% if block.settings.product.compare_at_price > block.settings.product.price %}
            {% assign discount_amount = block.settings.product.compare_at_price | minus: block.settings.product.price %}
            {% assign discount_percentage = discount_amount | times: 100.0 | divided_by: block.settings.product.compare_at_price | round %}
            <div class="discount-badge">-{{ discount_percentage }}%</div>
          {% endif %}
          
          {% if block.settings.media_type == 'video' and block.settings.video_url != blank %}
            <video 
              loop 
              muted 
              playsinline
              onmouseover="this.play()" 
              onmouseout="this.pause(); this.currentTime = 0;"
            >
              <source src="{{ block.settings.video_url }}" type="video/mp4">
            </video>
            <div class="video-overlay">
              <svg viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          {% elsif block.settings.product.featured_image %}
            {% comment %} Primary Image {% endcomment %}
            <img 
              src="{{ block.settings.product.featured_image | img_url: '800x' }}" 
              alt="{{ block.settings.product.title }}"
              class="primary"
              loading="lazy"
            >
            {% comment %} Secondary Image (if available) {% endcomment %}
            {% if block.settings.product.images[1] %}
              <img 
                src="{{ block.settings.product.images[1] | img_url: '800x' }}" 
                alt="{{ block.settings.product.title }}"
                class="secondary"
                loading="lazy"
              >
            {% endif %}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      </a>
      
      <div class="product-info">
        <a href="{{ block.settings.product.url }}" class="product-title">
          {{ block.settings.product.title }}
        </a>
        
        {% if block.settings.product.price %}
          <div class="product-price {% if block.settings.product.compare_at_price > block.settings.product.price %}on-sale{% endif %}">
            {{ block.settings.product.price | money }}
            {% if block.settings.product.compare_at_price > block.settings.product.price %}
              <span class="product-price-compare">{{ block.settings.product.compare_at_price | money }}</span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
    
    {% assign product_counter = product_counter | plus: 1 %}
    
    {% comment %} Close last row {% endcomment %}
    {% if forloop.last %}
      </div>
    {% endif %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Custom Product Grid",
  "tag": "section",
  "class": "section-custom-product-grid",
  "settings": [
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Featured Products"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "Media Type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ],
          "default": "image"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (MP4)",
          "info": "Upload video to Shopify Files and paste URL here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid",
      "category": "Products",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product",
          "settings": {
            "media_type": "video"
          }
        },
        {
          "type": "product",
          "settings": {
            "media_type": "video"
          }
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}