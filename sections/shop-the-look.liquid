<!-- DRAWER OVERLAY -->
<div class="stl-drawer-overlay" id="stlDrawerOverlay-{{ section.id }}" aria-hidden="true"></div>

<!-- DRAWER -->
<div 
  class="stl-drawer" 
  id="stlDrawer-{{ section.id }}" 
  role="dialog" 
  aria-modal="true" 
  aria-label="Complete your look"
>
  <!-- Header -->
  <div class="stl-drawer-header">
    <h3>Complete your look</h3>
    <button class="stl-drawer-close" id="stlDrawerClose-{{ section.id }}" aria-label="Close drawer">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Body: Products -->
  <div class="stl-drawer-body" id="stlDrawerBody-{{ section.id }}">
    {% assign has_products = false %}
    {% for block in section.blocks %}
      {% if block.settings.product != blank %}
        {% assign has_products = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_products %}
      {% for block in section.blocks %}
        {% if block.settings.product != blank %}
          {% assign product = all_products[block.settings.product] %}

          <div class="stl-drawer-product" data-product-id="{{ product.id }}">

            <!-- Top: Image + Meta -->
            <div class="stl-drawer-product-top">
              {% if product.featured_image %}
                <img 
                  src="{{ product.featured_image | img_url: '300x' }}" 
                  alt="{{ product.title }}"
                  class="stl-drawer-product-image"
                  loading="lazy"
                >
              {% endif %}
              <div class="stl-drawer-product-meta">
                {% if product.vendor != blank %}
                  <p class="stl-drawer-product-vendor">{{ product.vendor }}</p>
                {% endif %}
                <p class="stl-drawer-product-title">{{ product.title }}</p>
                <div class="stl-drawer-product-price">
                  {{ product.price | money_without_currency }}
                  <span class="currency">{{ cart.currency.iso_code }}</span>
                </div>
              </div>
            </div>

            <!-- Bottom: Size selector + Add to cart -->
            {% comment %} <div class="stl-drawer-product-actions">
              <div class="stl-size-select-wrapper">
                <select 
                  class="stl-size-select" 
                  data-product-id="{{ product.id }}"
                  aria-label="Select a size for {{ product.title }}"
                >
                  <option value="">Select a size</option>
                  {% for variant in product.variants %}
                    <option 
                      value="{{ variant.id }}" 
                      {% unless variant.available %}disabled{% endunless %}
                    >
                      {{ variant.title }}{% unless variant.available %} – Sold out{% endunless %}
                    </option>
                  {% endfor %}
                </select>
              </div>

              <button 
                class="stl-add-btn" 
                data-product-id="{{ product.id }}"
                aria-label="Add {{ product.title }} to cart"
              >
                Add
              </button>
            </div> {% endcomment %}
            <!-- Bottom: Size selector + Add to cart -->
<div class="stl-drawer-product-actions">
  {% if product.variants.size == 1 and product.variants.first.title == 'Default Title' %}
    <button class="stl-add-btn size-selected" data-variant-id="{{ product.variants.first.id }}" data-product-id="{{ product.id }}">Add</button>
  {% else %}
    <button class="stl-size-open-btn" data-product-id="{{ product.id }}">Select size</button>
    <button class="stl-add-btn" data-product-id="{{ product.id }}">Add</button>
  {% endif %}
</div>

<!-- SIZE MODAL for this product -->
<div class="cp-size-modal" id="stl-size-modal-{{ product.id }}">
  <div class="cp-size-modal-content">
    <div class="cp-modal-topbar">
      <button class="cp-modal-back cp-close" aria-label="Back">
        <svg viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="cp-close" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div class="cp-modal-title-area">
      <h3>Select your size</h3>
      <span class="cp-size-guide-link">View size guide</span>
    </div>
    <div class="cp-size-scroll">
      <div class="cp-size-row">
        <div class="cp-size-row-label"></div>
        <button class="cp-size-tile tags__sgd">Slim</button>
        <button class="cp-size-tile tags__sgd">Smart</button>
        <button class="cp-size-tile tags__sgd">Relaxed</button>
      </div>

      {% assign sizes = product.variants | map: 'option1' | uniq %}
      {% for size in sizes %}
        {% assign count = 0 %}
        {% for variant in product.variants %}
          {% if variant.option1 == size %}{% assign count = count | plus: 1 %}{% endif %}
        {% endfor %}
        <div class="cp-size-row">
          <div class="cp-size-row-label">{{ size }}</div>
          {% for variant in product.variants %}
            {% if variant.option1 == size %}
              {% if variant.available %}
                <button class="cp-size-tile" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
              {% else %}
                <button class="cp-size-tile sold-out" disabled><span class="sold-dot"></span>{{ variant.title }}</button>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if count < 3 %}<div class="cp-size-tile-empty"></div>{% endif %}
          {% if count == 1 %}<div class="cp-size-tile-empty"></div>{% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="cp-modal-footer">
      <div>
        <div class="cp-modal-price-amount">{{ product.price | money_without_trailing_zeros }}</div>
        <div class="cp-modal-price-delivery">Delivery: 1 to 4 business days</div>
      </div>
      <button class="cp-modal-add-btn" disabled>Add to bag</button>
    </div>
  </div>
</div>

          </div>
        {% endif %}
      {% endfor %}

    {% else %}
      <p class="stl-drawer-empty">No products added to this look yet.</p>
    {% endif %}
  </div>

  <!-- Footer: Skip -->
  <div class="stl-drawer-footer">
    <a href="/cart" class="stl-drawer-skip-btn" id="stlSkipBtn-{{ section.id }}">
      Skip this step and access your cart
    </a>
  </div>
</div>

<!-- SECTION HTML -->
<div class="shop-the-look-section" style="--section-padding-top: {{ section.settings.section_padding_top }}px; --section-padding-bottom: {{ section.settings.section_padding_bottom }}px;">

  <!-- Mobile hero wrapper: bg image + text overlay together -->
  <div class="stl-hero-wrapper">
    {% if section.settings.background_image %}
      <img 
        src="{{ section.settings.background_image | img_url: '1920x' }}" 
        alt="{{ section.settings.title }}"
        class="shop-the-look-bg"
        loading="lazy"
      >
    {% endif %}
    
    <div class="shop-the-look-overlay"></div>

    <div class="shop-the-look-content">
      <div class="shop-the-look-left">
        {% if section.settings.badge_text != blank %}
          <div class="shop-the-look-badge">{{ section.settings.badge_text }}</div>
        {% endif %}
        
        {% if section.settings.title != blank %}
          <h2 class="shop-the-look-title">{{ section.settings.title }}</h2>
        {% endif %}
      </div>

      <div class="shop-the-look-right">
        <div class="product-display-wrapper">
        <div class="product-thumbnails-vertical">
          {% for block in section.blocks %}
            {% if block.settings.product != blank %}
              {% assign product = all_products[block.settings.product] %}
              <a href="{{ product.url }}" class="thumbnail-item">
                {% if product.featured_image %}
                  <img 
                    src="{{ product.featured_image | img_url: '280x280' }}" 
                    alt="{{ product.title }}"
                    class="thumbnail-image"
                    loading="lazy"
                  >
                {% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>

        {% if section.settings.main_product != blank %}
          {% assign main_product = all_products[section.settings.main_product] %}
          <div class="main-product-card">
            {% if main_product.featured_image %}
              <img 
                src="{{ main_product.featured_image | img_url: '600x' }}" 
                alt="{{ main_product.title }}"
                class="main-product-image"
                loading="lazy"
              >
            {% endif %}
            <div class="main-product-info">
              <h3 class="main-product-title">{{ main_product.title }}</h3>
              <div class="main-product-price">{{ main_product.price | money }}</div>

              <button 
                class="main-product-link" 
                id="stlOpenDrawer-{{ section.id }}"
                aria-controls="stlDrawer-{{ section.id }}"
                aria-expanded="false"
              >
                {{ section.settings.cta_text }}
                <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
  </div>{%- comment -%}end stl-hero-wrapper{%- endcomment -%}

  <!-- MOBILE: 3-column image grid — shown BELOW bg image on mobile, hidden on desktop -->
  <div class="stl-mobile-images-row">
    {% if section.settings.main_product != blank %}
      {% assign main_product = all_products[section.settings.main_product] %}
      {% if main_product.featured_image %}
        <span class="stl-mobile-img-cell">
          <img src="{{ main_product.featured_image | img_url: '400x' }}" alt="{{ main_product.title }}" loading="lazy">
        </span>
      {% endif %}
    {% endif %}
    {% assign mob_count = 0 %}
    {% for block in section.blocks %}
      {% if mob_count >= 2 %}{% break %}{% endif %}
      {% if block.settings.product != blank %}
        {% assign bp = all_products[block.settings.product] %}
        {% if bp.featured_image %}
          <span class="stl-mobile-img-cell">
            <img src="{{ bp.featured_image | img_url: '400x' }}" alt="{{ bp.title }}" loading="lazy">
          </span>
          {% assign mob_count = mob_count | plus: 1 %}
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>

  <!-- MOBILE: CTA button — shown below image grid, hidden on desktop -->
  <button
    class="stl-mobile-cta"
    id="stlOpenDrawerMobile-{{ section.id }}"
    aria-controls="stlDrawer-{{ section.id }}"
    aria-expanded="false"
  >
    {{ section.settings.cta_text }}
    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

</div>
{% comment %} <script>
(function() {
  var sectionId = '{{ section.id }}';
  var openBtn       = document.getElementById('stlOpenDrawer-'       + sectionId);
  var openBtnMobile = document.getElementById('stlOpenDrawerMobile-' + sectionId);
  var closeBtn      = document.getElementById('stlDrawerClose-'      + sectionId);
  var overlay       = document.getElementById('stlDrawerOverlay-'    + sectionId);
  var drawer        = document.getElementById('stlDrawer-'           + sectionId);

  if (!drawer) return;

  /* ---------- Drawer open/close ---------- */
  function openDrawer() {
    drawer.classList.add('is-open');
    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeDrawer() {
    drawer.classList.remove('is-open');
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    if (openBtn) openBtn.focus();
    if (openBtnMobile) openBtnMobile.focus();
  }

  if (openBtn) openBtn.addEventListener('click', openDrawer);
  if (openBtnMobile) openBtnMobile.addEventListener('click', openDrawer);
  closeBtn.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && drawer.classList.contains('is-open')) closeDrawer();
  });

  /* ---------- Size select → activate Add button colour ---------- */
  drawer.querySelectorAll('.stl-size-select').forEach(function(select) {
    select.addEventListener('change', function() {
      var productId = select.getAttribute('data-product-id');
      var addBtn = drawer.querySelector('.stl-add-btn[data-product-id="' + productId + '"]');
      if (!addBtn) return;
      if (select.value) {
        addBtn.classList.add('size-selected');
      } else {
        addBtn.classList.remove('size-selected');
      }
    });
  });

  /* ---------- Add to cart ---------- */
  drawer.querySelectorAll('.stl-add-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var productId = btn.getAttribute('data-product-id');
      var select    = drawer.querySelector('.stl-size-select[data-product-id="' + productId + '"]');

      if (!select || !select.value) {
        // Highlight the select to prompt user to pick a size
        select.style.borderColor = '#c00';
        select.focus();
        setTimeout(function() { select.style.borderColor = ''; }, 2000);
        return;
      }

      var variantId = select.value;
      btn.textContent = '...';
      btn.classList.add('adding');
      btn.disabled = true;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      })
      .then(function(res) { return res.json(); })
      .then(function() {
        btn.textContent = 'Added';
        btn.classList.remove('adding');
        btn.classList.add('added');
        // Refresh cart count if theme exposes it
        if (typeof refreshCart === 'function') refreshCart();
        if (document.dispatchEvent) {
          document.dispatchEvent(new CustomEvent('cart:refresh'));
        }
        setTimeout(function() {
          btn.textContent = 'Add';
          btn.classList.remove('added', 'size-selected');
          btn.disabled = false;
        }, 2500);
      })
      .catch(function() {
        btn.textContent = 'Error';
        btn.classList.remove('adding');
        btn.disabled = false;
        setTimeout(function() { btn.textContent = 'Add'; }, 2000);
      });
    });
  });

})();
/* ── STL: Size modal open ── */
drawer.querySelectorAll('.stl-size-open-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var modal = document.getElementById('stl-size-modal-' + btn.getAttribute('data-product-id'));
    if (modal) modal.classList.add('active');
  });
});

/* ── STL: Size modal close ── */
drawer.querySelectorAll('.cp-size-modal').forEach(function(modal) {
  modal.addEventListener('click', function(e) {
    if (e.target === modal) modal.classList.remove('active');
  });
  modal.querySelectorAll('.cp-close').forEach(function(btn) {
    btn.addEventListener('click', function() { modal.classList.remove('active'); });
  });
});

/* ── STL: Size tile select ── */
drawer.querySelectorAll('.cp-size-tile:not(.sold-out):not(.tags__sgd)').forEach(function(tile) {
  tile.addEventListener('click', function() {
    var modal = tile.closest('.cp-size-modal');
    modal.querySelectorAll('.cp-size-tile').forEach(function(t) { t.classList.remove('selected'); });
    tile.classList.add('selected');
    var addBtn = modal.querySelector('.cp-modal-add-btn');
    addBtn.disabled = false;
    addBtn.dataset.variantId = tile.dataset.variantId;
  });
});

/* ── STL: Modal Add to cart ── */
drawer.querySelectorAll('.cp-modal-add-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var variantId = btn.dataset.variantId;
    if (!variantId) return;
    var modal = btn.closest('.cp-size-modal');
    btn.textContent = 'Adding...';
    btn.disabled = true;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(function(res) { return res.json(); })
    .then(function() {
      btn.textContent = 'Added to Cart';
      setTimeout(function() {
        modal.classList.remove('active');
        btn.textContent = 'Add to bag';
        btn.disabled = true;
        delete btn.dataset.variantId;
        modal.querySelectorAll('.cp-size-tile.selected').forEach(function(t) { t.classList.remove('selected'); });
      }, 1200);
    })
    .catch(function() {
      btn.textContent = 'Add to bag';
      btn.disabled = false;
    });
  });
});
</script> {% endcomment %}
