    font-weight: 500;
    color: #1a1a1a;
    margin: 0;
  }
  .cp-size-guide-link {
    display: none;
    margin-top: 6px;
    font-size: 12px;
    color: #888;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  .cp-col-headers {
    display: grid;
    grid-template-columns: 80px 1fr 1fr;
    padding: 6px 16px 8px;
    flex-shrink: 0;
  }
  .cp-col-headers .cp-ch {
    text-align: center;
    font-size: 13px;
    font-weight: 500;
    color: #1a1a1a;
  }
  .cp-col-headers .cp-ch span {
    display: block;
    font-size: 11px;
    font-weight: 400;
    color: #888;
    margin-top: 2px;
  }

  .cp-size-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 0 16px 12px;
  }

  .cp-size-row {
    display: grid;
    grid-template-columns: 80px 1fr 1fr 1fr;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
        position: sticky;
    top: 0;
    z-index: 99;
    background-color: #f0f0f0;
  }
  .cp-size-row-label {
    font-size: 12px;
    color: #999;
    text-align: left;
    padding-left: 4px;
  }
  .cp-size-tile {
    background: #fff;
    border: none;
    border-radius: 6px;
    height: 32px;
    width: 100%;
    font-size: 12px;
    color: #1a1a1a;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background 0.15s;
  }
    .cp-size-tile.tags__sgd{
    font-weight: 500;
    background: none;
    font-size: 14px;

  }
  .cp-size-tile:hover { background: #e8e8e8; }
  .cp-size-tile.selected { background: #1a1a1a; color: #fff; }
  .cp-size-tile.sold-out { color: #bbb; cursor: not-allowed; }
  .cp-size-tile.sold-out .sold-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid #f0a070;
    flex-shrink: 0;
  }
  .cp-size-tile-empty {
    background: #e8e8e8;
    border-radius: 6px;
    height: 32px;
  }

  .cp-modal-footer {
    flex-shrink: 0;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .cp-modal-price-amount {
    font-size: 18px;
    font-weight: 500;
    color: #1a1a1a;
  }
  .cp-modal-price-delivery {
    font-size: 12px;
    color: #888;
    margin-top: 3px;
  }
  .cp-modal-add-btn {
    height: 50px;
    padding: 0 32px;
    background: #1a1a1a;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .cp-modal-add-btn:hover { background: #333; }
  .cp-modal-add-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  @media(max-width: 768px) {
    .complementary-products-wraper { flex-direction: column; }
    .currently-open-product { width: 100%; }
    .complementary-products-drawer-content { max-width: 100%; }
    .cp-size-modal-content { max-width: 100%; }
    .cp-product-image { width: 150px; min-width: 150px; min-height: 200px; }
